    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "marked": "^17.0.1",
    "ora": "^9.1.0",
    "prettier": "^3.8.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.2.0",
    "@types/prompts": "^2.4.9",
    "eslint": "^9.39.2",
    "globals": "^17.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
