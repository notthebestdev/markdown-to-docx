{
  "name": "@thebestdev/md-to-docx",
  "version": "1.1.0",
  "description": "Transform Markdown into a Word document.",
  "keywords": [
    "markdown",
    "docx",
    "word",
    "converter",
    "cli"
  ],
  "author": "TheBestDeveloper",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notthebestdev/markdown-to-docx.git"
  },
  "bugs": {
    "url": "https://github.com/notthebestdev/markdown-to-docx/issues"
  },
  "homepage": "https://github.com/notthebestdev/markdown-to-docx#readme",
  "type": "module",
  "main": "./dist/app.js",
  "exports": {
    ".": "./dist/app.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "md-to-docx": "./dist/app.js"
  },
  "scripts": {
    "dev": "node src/app.ts",
    "test": "npm run build && tsx test/cli.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "build": "node scripts/build.ts",
    "postbuild": "chmod +x dist/app.js",
    "prepack": "npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "chokidar": "^4.0.3",
    "clipboardy": "^5.3.1",
    "html-docx-js-typescript": "^0.1.5",
    "marked": "^18.0.0",
    "ora": "^9.3.0",
    "pretty-ms": "^9.3.0",
    "prompts": "^2.4.2",
    "tinyglobby": "^0.2.16",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@types/prompts": "^2.4.9",
    "@types/yargs": "^17.0.35",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.0",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "prettier": "^3.8.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2"
  }
}
