{
  "name": "@thebestdev/md-to-docx",
  "version": "1.2.1",
  "description": "Transform Markdown into a Word document.",
  "keywords": [
    "markdown",
    "docx",
    "word",
    "converter",
    "cli"
  ],
  "author": "TheBestDeveloper",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notthebestdev/markdown-to-docx.git"
  },
  "bugs": {
    "url": "https://github.com/notthebestdev/markdown-to-docx/issues"
  },
  "homepage": "https://github.com/notthebestdev/markdown-to-docx#readme",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": "./dist/app.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "md-to-docx": "dist/app.js"
  },
  "scripts": {
    "dev": "tsx src/app.ts",
    "test": "npm run build && tsx --test test/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "sync-version": "tsx scripts/sync-version.ts",
    "release": "npm run build && npm run sync-version && changeset publish",
    "build:js": "tsx scripts/build.ts",
    "build:types": "tsc --emitDeclarationOnly",
    "build": "npm run build:js && npm run build:types",
    "postbuild": "chmod +x dist/app.js",
    "prepack": "npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "html-docx-js-typescript": "^0.1.5",
    "marked": "^18.0.0",
    "nanospinner": "^1.2.2",
    "picocolors": "^1.1.1",
    "pretty-ms": "^9.3.0",
    "prompts": "^2.4.2",
    "tinyclip": "^0.1.12",
    "tinyglobby": "^0.2.16",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.30.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@types/prompts": "^2.4.9",
    "@types/yargs": "^17.0.35",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.0",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "prettier": "^3.8.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2"
  }
}
